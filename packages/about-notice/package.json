{
  "name": "dsh-plugin-wallpaper-engine-about-notice",
  "version": "1.3.3",
  "description": "About tab host half: repo star count (/star-count) and the two contact QR images (/about-qr).",
  "icon": "./icon.png",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": ["lib/", "cordis.patch.yml", "locale/", "icon.png", "package.json"],
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "license": "MIT"
}
