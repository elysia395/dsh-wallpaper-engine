{
  "name": "dsh-plugin-wallpaper-engine-pet-link",
  "version": "1.4.2",
  "description": "Optional official dsh-pet bridge: public API control, four interaction sequences and independent page bubbles; no bundled pet or patching.",
  "icon": "./icon.png",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.pet-link.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "dsh-plugin-wallpaper-engine"],
      "platform": "web",
      "immediately": true
    }
  },
  "files": ["lib/", "cordis.patch.yml", "locale/", "icon.png", "package.json", "assets/"],
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "license": "MIT"
}
